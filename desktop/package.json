{
  "name": "hospital-ads-desktop",
  "version": "1.0.0",
  "description": "Aplicación de escritorio para personal del Hospital ADS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.hospitalads.desktop",
    "productName": "Hospital ADS",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*"
    ],
    "win": { "target": "nsis", "icon": "renderer/imagenes/app-icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
